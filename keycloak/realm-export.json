{
  "realm": "abstimmbar",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "abstimmbar-backend",
      "name": "Abstimmbar Backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "abstimmbar-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8002/*"
      ],
      "webOrigins": [
        "http://localhost:8002",
        "http://localhost:5174"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5174/*##http://localhost:8002/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "abstimmbar-admins"
    }
  ],
