      <respcondition continue="Yes"><conditionvar><varequal respident="OQT" index="0">1</varequal></conditionvar><setvar action="Add">1</setvar></respcondition>
      <respcondition continue="Yes"><conditionvar><varequal respident="OQT" index="1">2</varequal></conditionvar><setvar action="Add">1</setvar></respcondition>
