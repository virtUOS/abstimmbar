#: live/templates/live/home.html:4
msgid "Abstimmbar — join"
msgstr "Abstimmbar — teilnehmen"

#: live/templates/live/home.html:8
msgid "Join a poll"
msgstr "An einer Abstimmung teilnehmen"

#: live/templates/live/home.html:9
msgid "Enter the code shown on the wall."
msgstr "Gib den Code ein, der an der Wand angezeigt wird."

#: live/templates/live/home.html:12
msgid "e.g. tiger-komet-radio"
msgstr "z. B. tiger-komet-radio"

#: live/templates/live/home.html:13
msgid "Room code"
msgstr "Raum-Code"

#: live/templates/live/home.html:14
msgid "Continue"
msgstr "Weiter"

#: live/templates/live/not_found.html:4 live/templates/live/not_found.html:8
msgid "Room not found"
msgstr "Raum nicht gefunden"

#: live/templates/live/not_found.html:9
msgid "Check the code and try again."
msgstr "Prüfe den Code und versuche es erneut."

#: live/templates/live/not_found.html:11
msgid "Enter a code"
msgstr "Code eingeben"

#: live/templates/live/participant.html:15
msgid "Language"
msgstr "Sprache"

#: live/templates/live/participant.html:20
msgid "Deutsch"
msgstr "Deutsch"

#: live/templates/live/participant.html:22
msgid "English"
msgstr "English"

#: live/templates/live/participant.html:27
msgid "Menu"
msgstr "Menü"

#: live/templates/live/participant.html:32
#: live/templates/live/participant.html:128
msgid "My answers"
msgstr "Meine Antworten"

#: live/templates/live/participant.html:37
msgid "Connecting …"
msgstr "Verbinde …"

#: live/templates/live/participant.html:41
#: live/templates/live/participant.html:201
msgid "The vote has not started yet."
msgstr "Die Abstimmung hat noch nicht begonnen."

#: live/templates/live/participant.html:42
msgid "Keep this page open — it will start automatically."
msgstr "Lass diese Seite geöffnet — es geht automatisch los."

#: live/templates/live/participant.html:51
#: live/templates/live/participant.html:141
#: live/templates/live/participant.html:172
msgid "Your term …"
msgstr "Dein Begriff …"

#: live/templates/live/participant.html:51
#: live/templates/live/participant.html:67
#: live/templates/live/participant.html:141
#: live/templates/live/participant.html:143
#: live/templates/live/participant.html:172
#: live/templates/live/participant.html:174
msgid "Answer"
msgstr "Antwort"

#: live/templates/live/participant.html:52
#: live/templates/live/participant.html:69
#: live/templates/live/participant.html:145
#: live/templates/live/participant.html:176
#: live/templates/live/participant.html:212
msgid "Submit"
msgstr "Abschicken"

#: live/templates/live/participant.html:55
msgid ""
"You can submit several terms — but each only once. Use × to withdraw an "
"entry again."
msgstr ""
"Du kannst mehrere Begriffe einreichen — jeden aber nur einmal. Über das × "
"nimmst du einen Eintrag wieder zurück."

#: live/templates/live/participant.html:63
msgid "Done"
msgstr "Fertig"

#: live/templates/live/participant.html:67
#: live/templates/live/participant.html:143
#: live/templates/live/participant.html:174
msgid "Your answer …"
msgstr "Deine Antwort …"

#: live/templates/live/participant.html:71
#: live/templates/live/participant.html:147
#: live/templates/live/participant.html:178
msgid "Submit answer"
msgstr "Antwort abschicken"

#: live/templates/live/participant.html:81
msgid "Your answer was received."
msgstr "Deine Antwort ist angekommen."

#: live/templates/live/participant.html:82
msgid "Waiting for the next question."
msgstr "Warte auf die nächste Frage."

#: live/templates/live/participant.html:85
msgid "Evaluation of your answer"
msgstr "Auswertung deiner Antwort"

#: live/templates/live/participant.html:93
msgid "Voting is closed."
msgstr "Die Beantwortung ist geschlossen."

#: live/templates/live/participant.html:94
msgid "You can see the results on the screen."
msgstr "Die Ergebnisse siehst du an der Wand."

#: live/templates/live/participant.html:119
msgid "The vote has ended."
msgstr "Die Abstimmung ist beendet."

#: live/templates/live/participant.html:120
msgid "View my answers"
msgstr "Meine Antworten ansehen"

#: live/templates/live/participant.html:129
msgid "You have not answered anything in this round yet."
msgstr "Du hast in dieser Runde noch nichts beantwortet."

#: live/templates/live/participant.html:131
msgid "Back"
msgstr "Zurück"

#: live/templates/live/participant.html:149
#: live/templates/live/participant.html:207
msgid "Next"
msgstr "Weiter"

#: live/templates/live/participant.html:155
msgid "You can close this page now."
msgstr "Du kannst diese Seite jetzt schließen."

#: live/templates/live/participant.html:161
msgid "Previous question"
msgstr "Vorherige Frage"

#: live/templates/live/participant.html:164
msgid "Next question"
msgstr "Nächste Frage"

#: live/templates/live/participant.html:202
msgid "Almost there — look at the screen."
msgstr "Gleich geht es weiter — schau an die Wand."

#: live/templates/live/participant.html:203
#, python-brace-format
msgid "{n}s left"
msgstr "noch {n} s"

#: live/templates/live/participant.html:204
msgid "Correct!"
msgstr "Richtig!"

#: live/templates/live/participant.html:205
msgid "Not quite right."
msgstr "Leider nicht richtig."

#: live/templates/live/participant.html:206
msgid "Answer saved."
msgstr "Antwort gespeichert."

#: live/templates/live/participant.html:208
msgid "See results"
msgstr "Zur Auswertung"

#: live/templates/live/participant.html:209
#, python-brace-format
msgid "Done! {right} of {total} auto-graded questions correct."
msgstr "Geschafft! {right} von {total} automatisch bewerteten Fragen richtig."

#: live/templates/live/participant.html:210
#, python-brace-format
msgid "Done! You answered all {total} questions."
msgstr "Geschafft! Du hast alle {total} Fragen beantwortet."

#: live/templates/live/participant.html:211
msgid "Add"
msgstr "Hinzufügen"

#: live/templates/live/participant.html:213
msgid "You already submitted this term."
msgstr "Diesen Begriff hast du schon genannt."

#: live/templates/live/participant.html:214
msgid "You have reached the maximum number of terms."
msgstr "Du hast die maximale Anzahl an Begriffen erreicht."

#: live/templates/live/participant.html:215
#, python-brace-format
msgid "Remove term “{word}”"
msgstr "Begriff „{word}“ entfernen"

#: live/templates/live/participant.html:216
msgid "Your answer: "
msgstr "Deine Antwort: "

#: live/templates/live/participant.html:217
msgid "Not answered."
msgstr "Nicht beantwortet."

#: live/templates/live/participant.html:218
msgid "your choice"
msgstr "deine Wahl"

#: live/templates/live/participant.html:219
#, python-brace-format
msgid "{used} of {total} points allocated"
msgstr "{used} von {total} Punkten vergeben"

#: live/templates/live/participant.html:220
msgid "lower a value to reallocate points"
msgstr "reduziere einen Wert, um Punkte neu zu verteilen"

#: live/templates/live/participant.html:221
msgid "Drag the items or use the arrows to sort them."
msgstr "Zieh die Elemente oder nutze die Pfeile zum Sortieren."

#: live/templates/live/participant.html:222
msgid "correct order"
msgstr "komplett richtig"

#: live/templates/live/participant.html:223
msgid "correctly placed"
msgstr "richtig platziert"

#: live/templates/live/participant.html:224
msgid "Your order"
msgstr "Deine Reihenfolge"

#: live/templates/live/participant.html:225
msgid "Correct order"
msgstr "Richtige Reihenfolge"

#: live/templates/live/participant.html:226
msgid "All correct!"
msgstr "Alles richtig!"

#: live/templates/live/participant.html:227
msgid "Move up"
msgstr "Nach oben"

#: live/templates/live/participant.html:228
msgid "Move down"
msgstr "Nach unten"

#: live/templates/live/participant.html:229
msgid "you"
msgstr "du"

#: live/templates/live/participant.html:230
#, python-brace-format
msgid "Question {i} of {n}"
msgstr "Frage {i} von {n}"

#: live/templates/live/participant.html:231
msgid "Time is up."
msgstr "Die Zeit ist abgelaufen."
