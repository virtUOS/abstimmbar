# Local development configuration. Copy to `.env` and edit — `.env` is
# gitignored. Everything here is optional: without a `.env` the stack comes up
# with the defaults baked into docker-compose.yml (local Keycloak, no AI, no
# machine translation).
#
#   cp .env.example .env
#   docker compose up -d           # Compose reads .env automatically
#
# In a Docker-less sandbox (Claude Code on the web) the same file is read by
# .claude/hooks/session-start.sh and exported into the session environment;
# there the *_PORT settings below do not apply (native ports: 5432/8000/5173).
# Django reads env only at startup — after editing, `docker compose up -d`
# (recreates the container) or restart uvicorn. To check what actually arrived:
#
#   docker compose exec backend python scripts/check_integrations.py --probe
#
# It prints the resolved OIDC endpoints and whether AI/translation are on, and
# with --probe calls each configured service once. Secrets stay masked.

# --- Host ports (Docker only) ------------------------------------------------
# Shifted against Ausleihbar's defaults so both stacks can run side by side.
#POSTGRES_PORT=5433
#BACKEND_PORT=8002
#KEYCLOAK_PORT=8081
#FRONTEND_PORT=5174

# --- Django ------------------------------------------------------------------
#DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
#DJANGO_DEBUG=1
# Where the SPA lives, used for QR codes / short URLs and login redirects.
#FRONTEND_BASE_URL=http://localhost:5174

# --- Keycloak / OIDC ---------------------------------------------------------
# Default: the bundled dev realm (keycloak/realm-export.json) on
# localhost:8081, users demo/demo and admin-demo/demo. Client secret and
# endpoints are already wired in docker-compose.yml — nothing to set here.
#OIDC_RP_CLIENT_ID=abstimmbar-backend
#OIDC_RP_CLIENT_SECRET=abstimmbar-dev-secret
# Members of this IdP group get Django admin on login (empty = disabled).
#OIDC_ADMIN_GROUP=abstimmbar-admins
#OIDC_GROUPS_CLAIM=groups
# Claim names — uncomment only if the IdP uses non-standard ones.
#OIDC_CLAIM_USERNAME=preferred_username
#OIDC_CLAIM_EMAIL=email
#OIDC_CLAIM_FIRST_NAME=given_name
#OIDC_CLAIM_LAST_NAME=family_name
#
# To use a *different* Keycloak (own instance, institutional SSO) set the
# issuer and blank the five endpoints — settings.py then reads them from
# <issuer>/.well-known/openid-configuration. The empty assignments are
# required: unset would fall back to the local-Keycloak defaults in
# docker-compose.yml and the discovery would never run.
#OIDC_OP_ISSUER=https://sso.example.org/realms/example
#OIDC_OP_AUTHORIZATION_ENDPOINT=
#OIDC_OP_TOKEN_ENDPOINT=
#OIDC_OP_USER_ENDPOINT=
#OIDC_OP_JWKS_ENDPOINT=
#OIDC_OP_LOGOUT_ENDPOINT=
#
# Individual endpoints can also be overridden one by one (that is how the local
# split works: the browser reaches Keycloak at localhost, the backend at
# host.docker.internal). Explicit values always win over the issuer.
#
# The redirect URI to register in the IdP client is
#   http://localhost:8002/oidc/callback/
# and the post-login/logout targets are:
#OIDC_LOGIN_REDIRECT_URL=http://localhost:5174/
#OIDC_LOGOUT_REDIRECT_URL=http://localhost:5174/

# --- LiteLLM (optional AI features) ------------------------------------------
# Any OpenAI-compatible endpoint; the backend talks plain HTTP to
# <AI_BASE_URL>/chat/completions (stdlib urllib, no litellm/openai package).
# All four of provider/base/key/model are required — otherwise AI stays off and
# `GET /api/whoami/` reports "ai_enabled": false.
#AI_PROVIDER=litellm
#AI_BASE_URL=https://litellm.example.org/v1
#AI_API_KEY=sk-change-me
#AI_MODEL=qwen-3.5
#AI_TIMEOUT=30
#AI_MAX_TOKENS=2000
# Set to 0 for models that don't support the "disable thinking" hint.
#AI_DISABLE_THINKING=1

# --- LibreTranslate (optional content-translation pre-fill) ------------------
# Canonical language of authored content; must be one of the UI languages
# (de/en). Existing data is German — keep "de".
#CONTENT_DEFAULT_LANGUAGE=de
# Enables the "translate from <lang>" button in the editor (POST
# /api/translate/). The URL is the LibreTranslate root, without /translate.
# A local instance is one container:
#   docker run -d -p 5000:5000 libretranslate/libretranslate --load-only en,de
# then use http://host.docker.internal:5000 (from the backend container).
#CONTENT_TRANSLATION_PROVIDER=libretranslate
#LIBRETRANSLATE_URL=https://libretranslate.example.org
#LIBRETRANSLATE_API_KEY=

# --- Uploaded images ---------------------------------------------------------
# Downscaled + re-encoded to WebP on upload; override only to tune.
#IMAGE_MAX_EDGE=1600
#IMAGE_WEBP_QUALITY=80
